# 视觉大模型 API 配置示例（复制本文件为 .env 并填入你的密钥；.env 已被 .gitignore 忽略）
# 也可直接启动桌面工作台后，点击右上角「⚙ 大模型 API」在网页中配置并测试连通性。

# 运营商预设：doubao / mimo / mimo_token / deepseek / qwen / zhipu / custom
VLM_PROVIDER=doubao

# 通用配置（当切换非豆包运营商或自定义 OpenAI 兼容中转站时填写；留空则使用所选预设默认值）
# VLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
# VLM_MODEL=doubao-seed-2-1-lite-260915
# VLM_API_KEY=your_api_key_here

# 火山方舟（豆包）专用密钥（与 VLM_API_KEY 任选其一即可；系统环境变量优先于 .env）
ARK_API_KEY=your_ark_api_key_here
